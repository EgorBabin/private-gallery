# COPY TO .env

# Caddy gets an HTTPS certificate for SERVER_NAME from Let's Encrypt (ports 80 and 443 must be open)
SERVER_NAME=example.com
LE_EMAIL=you@example.com

VITE_NAME=Example web       # Name website and bla-bla
VITE_DOMAIN=Example.com
VITE_PROTOCOL=https://

LOG_LEVEL= #debug

FRONTEND_URL=https://example.com

SESSION=session                     #name
SESSION_SECRET=change_me_to_long_random_secret # для подписи сессий
# SESSION_BIND_IP: log out when the client IP changes (off by default: phones switch between Wi-Fi and mobile data)
SESSION_BIND_IP=false
# RATE_LIMIT_PER_MINUTE: API requests per IP per minute (login endpoints have a stricter separate limit)
RATE_LIMIT_PER_MINUTE=600

# s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ORIGIN: where signed media links point, used by the Content-Security-Policy in Caddy.
#   path-style (S3_FORCE_PATH_STYLE=true): the S3_ENDPOINT origin, e.g. https://storage.yandexcloud.net
#   virtual-hosted style: https://<bucket>.<endpoint host>
#   If not set, images/video are allowed from any https origin.
# S3_PUBLIC_ORIGIN=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_WINDOW_SEC: previews and screen images get signed links that stay the same for this window,
#   so the browser can cache them (default 3600 = 1h, max 172800 = 2 days). A link stays valid for 2.5 windows.
#   Smaller = links leaked from the browser expire sooner, larger = fewer re-downloads.
S3_SIGNED_URL_WINDOW_SEC=3600
# S3_RESPONSE_CACHE_CONTROL: optional, e.g. "private, max-age=86400". Adds response-cache-control to signed links
#   so files uploaded before Cache-Control metadata was set are cached too. Enable only if your S3 provider supports it.
S3_RESPONSE_CACHE_CONTROL=

# upload limits (backend)
# RAW files from modern cameras are 25-80 MB
MAX_UPLOAD_MB=100
MAX_UPLOAD_IMAGES=15
# frontend file selection limit
VITE_MAX_UPLOAD_IMAGES=15

# background worker (job queue is stored in PostgreSQL)
# PHOTO_WORKER_RETRY_MS: delay before reconnecting to PostgreSQL after a failure
PHOTO_WORKER_RETRY_MS=3000
GALLERY_SOFT_DELETE_RETENTION_DAYS=30
GALLERY_SOFT_DELETE_SWEEP_INTERVAL_MS=3600000
GALLERY_SOFT_DELETE_DELETE_CONCURRENCY=8
# AUDIT_LOG_RETENTION_DAYS: how long the admin "Журнал" keeps entries (IP, device, actions)
AUDIT_LOG_RETENTION_DAYS=180
# STRIP_GPS_ON_UPLOAD: remove GPS coordinates from new originals on upload (image and other metadata stay intact).
#   Already uploaded files: docker compose run --rm photo-worker node scripts/stripLocation.js --apply
STRIP_GPS_ON_UPLOAD=false

# container resource limits (docker-compose.yaml)
# photo-worker CPU limit must not exceed the number of server CPUs
PHOTO_WORKER_CPUS=1.0
PHOTO_WORKER_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=768m
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=96m
REDIS_MAXMEMORY=64mb
CADDY_MEM_LIMIT=128m

# redis cache (optional but recommended for performance)
# Either use REDIS_URL or REDIS_HOST + REDIS_PORT + REDIS_PASSWORD
# REDIS_URL=redis://:password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_CACHE_TTL_SEC: time-to-live for preview key cache in Redis (in seconds, default 86400 = 24h)
REDIS_CACHE_TTL_SEC=86400
# GALLERY_CACHE_REFRESH_MS: interval for periodic background refresh of preview caches from S3 (in ms, default 3600000 = 1h)
#   the cache is also refreshed after every upload/reorder/delete, so this only catches changes made directly in S3
GALLERY_CACHE_REFRESH_MS=3600000

# previews listing limits
# PREVIEWS_DEFAULT_LIMIT: default number of items returned when no `limit` query provided
#   set to 0 to disable default limit and fetch all pages
PREVIEWS_DEFAULT_LIMIT=5000
# PREVIEWS_MAX_LIMIT: maximum allowed items requested via `limit` query (0 = no max cap)
PREVIEWS_MAX_LIMIT=0

# postgreSql
PG_USER=postgres
PG_PASSWORD=password
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=gallery

# first user 
APP_INIT_USERNAME=admin
APP_INIT_EMAIL=admin@gmail.com         # a@gmail.com,b@yandex.ru
APP_INIT_ROLE=admin
APP_INIT_TG_ID=123456
APP_INIT_IS_ACTIVE=true

# oauth google (Google Cloud Console -> Google Auth Platform -> Clients -> Web application)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly; scopes: openid, email
GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=secret
GOOGLE_REDIRECT_URI=https://example.com/api/google/callback

# oauth yandex
YANDEX_CLIENT_ID=123
YANDEX_CLIENT_SECRET=secret
YANDEX_REDIRECT_URI=https://example.com/api/yandex/callback

# telegram bot, logger (only important events are sent: logins, edits, uploads, errors)
TG_BOT_TOKEN=1234567890:bla_Bla_BLa12
TG_CHAT_ID=-100123
