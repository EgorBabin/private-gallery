# COPY TO .env

SERVER_NAME=example.com
LE_EMAIL=you@example.com
TRAEFIK_COMMON_NETWORK=common

VITE_NAME=Example web       # Name website and bla-bla
VITE_DOMAIN=Example.com
VITE_PROTOCOL=https://
VITE_TG_BOT_USERNAME=yourTgBot

LOG_LEVEL= #debug

FRONTEND_URL=https://example.com

SESSION=session                     #name
SESSION_SECRET=change_me_to_long_random_secret # для подписи сессий

# s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# upload limits (backend)
MAX_UPLOAD_MB=20
MAX_UPLOAD_IMAGES=15
# frontend file selection limit
VITE_MAX_UPLOAD_IMAGES=15

# rabbitmq + worker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=gallery.photo.jobs
PHOTO_WORKER_PREFETCH=1
PHOTO_WORKER_RETRY_MS=3000
GALLERY_SOFT_DELETE_RETENTION_DAYS=30
GALLERY_SOFT_DELETE_SWEEP_INTERVAL_MS=3600000
GALLERY_SOFT_DELETE_DELETE_CONCURRENCY=8

# postgreSql
PG_USER=postgres
PG_PASSWORD=password
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=gallery

# first user 
APP_INIT_USERNAME=admin
APP_INIT_EMAIL=admin@gmail.com         # a@gmail.com,b@yandex.ru
APP_INIT_ROLE=admin
APP_INIT_TG_ID=123456
APP_INIT_IS_ACTIVE=true

# oauth yandex
YANDEX_CLIENT_ID=123
YANDEX_CLIENT_SECRET=secret
YANDEX_REDIRECT_URI=https://example.com/api/yandex/callback

# telegram bot, logger
TG_BOT_TOKEN=1234567890:bla_Bla_BLa12
TG_CHAT_ID=-100123
