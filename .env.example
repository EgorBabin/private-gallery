# COPY TO .env

SERVER_NAME=example.com
LE_EMAIL=you@example.com

VITE_NAME=Example web       # Name website and bla-bla
VITE_DOMAIN=Example.com
VITE_PROTOCOL=https://

FRONTEND_URL=https://example.com

SESSION=session                     #name
SESSION_SECRET=my_super_secret_123  # для подписи сессий

# s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# postgreSql
PG_USER=postgres
PG_PASSWORD=password
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=gallery

# first user 
APP_INIT_USERNAME=admin
APP_INIT_EMAIL=admin@gmail.com         # a@gmail.com,b@yandex.ru
APP_INIT_ROLE=admin
APP_INIT_PHONE=70000000000

# oauth yandex
YANDEX_CLIENT_ID=123
YANDEX_CLIENT_SECRET=secret
YANDEX_REDIRECT_URI=https://example.com/api/yandex/callback

# telegram bot, logger
TG_BOT_TOKEN=1234567890:bla_Bla_BLa12
TG_CHAT_ID=-100123
